algoritmo "Primeiro Programa"

var
  senha,  : inteiro

inicio

  escreval ("escreva a senha")
  leia (senha)
  enquanto senha <> 1234 faca
    escreval ("a senha : ", senha , " está incorreta")
    escreval ("digite sua senha")
    leia (senha)
  fimenquanto
  se senha = 1234 entao
    escreva ("senha correta!")
  fimse






fimalgoritmo
