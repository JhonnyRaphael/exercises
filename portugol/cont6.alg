algoritmo "Primeiro Programa"

var
  n,  : inteiro

inicio


  escreval ("escreva um numero de 1 a 10")
  leia (n)
  enquanto n <= 0 ou n > 10 faca
    escreval ("o numero deve ser de 1 a 10")
    leia (n)
  fimenquanto
  se n > 0 e n <= 10 entao
    escreval ("obrigado")
  fimse
  

   
fimalgoritmo
