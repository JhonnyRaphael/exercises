algoritmo "Primeiro Programa"

var
  n, total : inteiro

inicio
  total <- 0
  escreval ("escreva um numero") 
  leia (n)
  enquanto n <> 0 faca
  total <- total + n
  escreval (total)
  escreval ("digite um numero")
  leia (n)

  fimenquanto
  se n = 0 entao 
      escreva ("a soma dos numeros total doi de ", total)
    fimse
  

   
fimalgoritmo
